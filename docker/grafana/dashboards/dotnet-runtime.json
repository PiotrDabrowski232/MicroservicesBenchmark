{
  "title": ".NET Runtime (GC / ThreadPool)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "GC Collections Rate (per generation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job, generation) (rate(process_runtime_dotnet_gc_collections_count{job=~\"order-service|inventory-service|payment-service\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{generation}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "GC Heap Size (per generation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job, generation) (process_runtime_dotnet_gc_heap_size_bytes{job=~\"order-service|inventory-service|payment-service\"})",
          "legendFormat": "{{job}} {{generation}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Allocation Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(process_runtime_dotnet_gc_allocations_size_bytes_total{job=~\"order-service|inventory-service|payment-service\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "GC Committed Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (process_runtime_dotnet_gc_committed_memory_size_bytes{job=~\"order-service|inventory-service|payment-service\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "ThreadPool Threads Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (process_runtime_dotnet_thread_pool_threads_count{job=~\"order-service|inventory-service|payment-service\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "ThreadPool Queue Length",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (process_runtime_dotnet_thread_pool_queue_length{job=~\"order-service|inventory-service|payment-service\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Monitor Lock Contention Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(process_runtime_dotnet_monitor_lock_contention_count{job=~\"order-service|inventory-service|payment-service\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
