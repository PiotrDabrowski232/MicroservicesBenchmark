{
  "title": ".NET Runtime (GC / ThreadPool)",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "GC Collections Rate (per generation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job, gc_heap_generation) (rate(dotnet_gc_collections_total{job=~\"order-service|inventory-service|payment-service\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{gc_heap_generation}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "GC Heap Size (per generation, last collection)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job, gc_heap_generation) (dotnet_gc_last_collection_heap_size_bytes{job=~\"order-service|inventory-service|payment-service\"})",
          "legendFormat": "{{job}} {{gc_heap_generation}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Allocation Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(dotnet_gc_heap_total_allocated_bytes_total{job=~\"order-service|inventory-service|payment-service\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "GC Pause Time (fraction of time in GC)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(dotnet_gc_pause_time_seconds_total{job=~\"order-service|inventory-service|payment-service\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "ThreadPool Threads Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (dotnet_thread_pool_thread_count_total{job=~\"order-service|inventory-service|payment-service\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "ThreadPool Queue Length",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (dotnet_thread_pool_queue_length_total{job=~\"order-service|inventory-service|payment-service\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Monitor Lock Contention Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(dotnet_monitor_lock_contentions_total{job=~\"order-service|inventory-service|payment-service\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "GC Committed Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (dotnet_gc_last_collection_memory_committed_size_bytes{job=~\"order-service|inventory-service|payment-service\"})",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
